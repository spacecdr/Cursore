# Copiare in .env SOLO se non esiste. Non inserire credenziali in questo template.
GROQ_API_KEY=
# Il compose attuale richiede anche questa chiave; Gemini non è nel percorso attivo.
GEMINI_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-20b
PIPER_MODEL=it_IT-riccardo-x_low
# Variabili legacy: il codice attuale chiama direttamente GroqLLM e PiperTTS.
# TTS_PROVIDER non seleziona il provider nel percorso attivo.
TTS_PROVIDER=piper
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
