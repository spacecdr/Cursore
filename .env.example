# Copiare in .env SOLO se non esiste. Non inserire credenziali in questo template.
# IPv4 LAN realmente assegnato al server Docker (non 127.0.0.1 o 0.0.0.0).
CURSORE_LAN_IP=
CURSORE_PORT=8766
GROQ_API_KEY=
# Opzionale: Gemini non è nel percorso attivo.
GEMINI_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-20b
PIPER_MODEL=it_IT-riccardo-x_low
# Variabili legacy: il codice attuale chiama direttamente GroqLLM e PiperTTS.
# TTS_PROVIDER non seleziona il provider nel percorso attivo.
TTS_PROVIDER=piper
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
